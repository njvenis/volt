# UVM G7 packaging image. CE is the runtime base so its supported Django,
# uwsgi and Celery installation is exactly the candidate CE 3.5.0 build.
ARG CE_IMAGE=defectdojo/defectdojo-django@sha256:cb027c6e84adfe9cfe7de07863eeaae4a4375ff4420b7c41ea4e563631f4359e
ARG VALKEY_IMAGE=valkey/valkey:9.1.2-alpine@sha256:a174b894902bd3367e330d47cc2054367dc4917701776aaf336f41d83b65ec7a
FROM ${CE_IMAGE} AS uvm-build
ARG TARGETARCH
USER root
RUN test "$(dpkg --print-architecture)" = "$TARGETARCH" && python -m pip install --no-cache-dir uv==0.12.18
WORKDIR /build
ENV UV_PROJECT_ENVIRONMENT=/opt/uvm/venv
RUN install -d -m 0755 /opt/uvm
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY uvm ./uvm
COPY migrations ./migrations
COPY alembic.ini ./
COPY docker/g7/schema-head /tmp/uvm-g7-schema-head
RUN uv sync --frozen --no-dev
RUN set -eu; \
    declared=$(cat /tmp/uvm-g7-schema-head); \
    actual=$(/opt/uvm/venv/bin/python -c 'from alembic.config import Config; from alembic.script import ScriptDirectory; heads=ScriptDirectory.from_config(Config("/build/alembic.ini")).get_heads(); print(heads[0] if len(heads) == 1 else "multiple:" + ",".join(heads))'); \
    test "$actual" = "$declared" || { echo "declared runtime schema head $declared differs from the sole migration graph head $actual" >&2; exit 1; }
# uv uses a symlink to the builder interpreter by default. After the venv is
# copied into the runtime image, that symlink resolves outside the venv and
# CPython skips pyvenv.cfg. Keep a venv-local executable so pinned runtime
# dependencies and generated console-script shebangs resolve consistently.
RUN cp -L /opt/uvm/venv/bin/python /opt/uvm/venv/bin/python-uvm \
    && chmod 0755 /opt/uvm/venv/bin/python-uvm \
    && ln -sfn python-uvm /opt/uvm/venv/bin/python

FROM node:24.15.0-bookworm-slim@sha256:4e6b70dd6cbfc88c8157ba19aa3d9f9cce6ba4703576d55459e45efcbc9c5f5d AS ui-build
WORKDIR /ui
COPY ui/package.json ui/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY ui ./
RUN npm run build

FROM ${VALKEY_IMAGE} AS valkey-bin
ARG TARGETARCH
RUN set -eu; case "$TARGETARCH" in amd64) musl_arch=x86_64;; arm64) musl_arch=aarch64;; *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1;; esac; \
    cp "/lib/ld-musl-${musl_arch}.so.1" /tmp/volt-valkey-ld-musl.so.1; \
    cp "/lib/libc.musl-${musl_arch}.so.1" /tmp/volt-valkey-libc.musl.so.1

FROM ${CE_IMAGE} AS runtime
ARG TARGETARCH
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN python3 - <<'PY'
from pathlib import Path
path = Path('/entrypoint-uwsgi.sh')
source = path.read_text()
needle = '--http 0.0.0.0:8081 --http-to'
replacement = '--http 127.0.0.1:8081 --http-to'
count = source.count(needle)
if count != 1:
    raise SystemExit(f'expected exactly one CE HTTP bind directive, found {count}')
path.write_text(source.replace(needle, replacement))
PY
RUN python3 - <<'PY'
from pathlib import Path
path = Path('/entrypoint-celery-beat.sh')
source = path.read_text()
needle = '  --schedule=/var/run/defectdojo/celerybeat-schedule'
replacement = needle + ' \\\n  --scheduler=beat_progress_scheduler.G7ProgressScheduler'
if source.count(needle) != 1:
    raise SystemExit('expected exactly one CE celery beat schedule option')
path.write_text(source.replace(needle, replacement))
PY
RUN python3 - <<'PY'
from pathlib import Path
path = Path('/app/dojo/settings/settings.dist.py')
source = path.read_text()
needle = 'MIDDLEWARE = DJANGO_MIDDLEWARE_CLASSES'
replacement = 'MIDDLEWARE = ["g7_verification_middleware.ReadOnlyRecoveryMiddleware", *DJANGO_MIDDLEWARE_CLASSES]'
if source.count(needle) != 1:
    raise SystemExit('expected exactly one DefectDojo middleware assignment')
path.write_text(source.replace(needle, replacement))
PY
# PGDG removes old versions from its live index. Exact archived binary bytes
# remain subject to the original SHA-256, installed-version and delta checks.
COPY docker/g7/versions.lock /tmp/uvm-g7-versions.lock
COPY third-party/notices/OAUTHLIB-4.0.1-BSD-3-Clause.txt /tmp/ce-global-oauthlib-license.txt
RUN set -eu; \
    test "$(dpkg --print-architecture)" = "$TARGETARCH"; \
    export DEBIAN_FRONTEND=noninteractive APT_LISTCHANGES_FRONTEND=none; \
    apt-get update -qq; \
    mkdir -p /tmp/os-packages; cd /tmp/os-packages; \
    packages=''; expected_delta=''; verified_debs=(); \
    dpkg-query -W -f='${Package}=${Version}\n' | sort > /tmp/g7-packages-before; \
    while IFS='=|' read -r key version digest; do \
      arch=''; case "$key" in *:amd64) arch=amd64 ;; *:arm64) arch=arm64 ;; esac; \
      if [ -n "$arch" ] && [ "$arch" != "$TARGETARCH" ]; then continue; fi; \
      case "$key" in \
        os_delta_package_*) package=${key#os_delta_package_}; is_delta=1 ;; \
        os_package_*) package=${key#os_package_}; is_delta=0 ;; \
        *) continue ;; \
      esac; \
      package=${package%%:*}; \
      if [ "$is_delta" = 1 ]; then expected_delta+="$package=$version"$'\n'; fi; \
      case "$package" in \
        postgresql-18|postgresql-client-18|postgresql-common|postgresql-client-common) \
          archive_source=postgresql-18; \
          case "$package" in *-common) archive_source=postgresql-common ;; esac; \
          deb="${package}_${version}_${arch:-all}.deb"; \
          python3 -c 'import pathlib,sys,urllib.request; url="https://apt-archive.postgresql.org/pub/repos/apt/pool/main/p/"+sys.argv[1]+"/"+sys.argv[2]; response=urllib.request.urlopen(url,timeout=60); data=response.read(67108865); response.close(); assert len(data)<=67108864, "PGDG package exceeds bound"; pathlib.Path(sys.argv[2]).write_bytes(data)' "$archive_source" "$deb" ;; \
        *) apt-get download -qq "$package=$version" ;; \
      esac; \
      deb=$(find . -maxdepth 1 -type f -name "${package%%:*}_*.deb" -print -quit); \
      test -n "$deb"; \
      printf '%s  %s\n' "$digest" "$deb" | sha256sum -c -; \
      verified_debs+=("$deb"); \
      packages="$packages $package=$version"; \
    done < <(grep -E '^os_(delta_)?package_' /tmp/uvm-g7-versions.lock); \
    apt-get install -yqq --no-install-recommends "${verified_debs[@]}"; \
    for entry in $packages; do expected=${entry#*=}; package=${entry%%=*}; \
      actual=$(dpkg-query -W -f='${Version}' "$package"); test "$actual" = "$expected"; \
    done; \
    dpkg-query -W -f='${Package}=${Version}\n' | sort > /tmp/g7-packages-after; \
    python3 -c 'import sys; read=lambda p: dict(line.rstrip("\n").split("=",1) for line in open(p)); before,after=map(read,sys.argv[1:3]); open(sys.argv[3],"w").writelines(f"{k}={v}\n" for k,v in sorted(after.items()) if before.get(k)!=v); open(sys.argv[4],"w").write("\n".join(sorted(before.keys()-after.keys())))' /tmp/g7-packages-before /tmp/g7-packages-after /tmp/g7-packages-added-or-upgraded /tmp/g7-packages-removed; \
    printf '%s' "$expected_delta" | sort > /tmp/g7-packages-pinned; \
    python3 -c 'import sys; read=lambda p: dict(line.rstrip("\n").split("=",1) for line in open(p)); before=read(sys.argv[1]); expected=read(sys.argv[2]); open(sys.argv[3],"w").writelines(f"{k}={v}\n" for k,v in sorted(expected.items()) if before.get(k)!=v)' /tmp/g7-packages-before /tmp/g7-packages-pinned /tmp/g7-packages-expected; \
    diff -u /tmp/g7-packages-expected /tmp/g7-packages-added-or-upgraded; \
    test ! -s /tmp/g7-packages-removed; \
    rm -f /etc/ssl/private/ssl-cert-snakeoil.key /etc/ssl/certs/ssl-cert-snakeoil.pem; \
    cd / && rm -rf /tmp/os-packages /var/lib/apt/lists/* \
    && groupadd --system --gid 1800 uvm \
    && useradd --system --uid 1800 --gid uvm --home-dir /opt/uvm --create-home uvm \
    && groupadd --system --gid 1801 valkey \
    && useradd --system --uid 1801 --gid valkey --home-dir /var/lib/valkey --create-home valkey \
    && chmod 0755 /opt/uvm \
    && pg_dropcluster --stop 18 main \
    && rm -rf /var/lib/postgresql/18/main /etc/postgresql/18/main /var/log/postgresql \
    && install -d -o 1001 -g 1337 /app/media \
    && install -d -o uvm -g uvm /opt/uvm/state
# Pin the CE-global OAuthlib distribution independently from the UVM venv.
# The wheel URL and hash are recorded in docker/g7/versions.lock; pip verifies
# that exact wheel and installs no transitive dependency changes.
RUN set -eu; \
    line=$(grep '^ce_global_python_oauthlib=' /tmp/uvm-g7-versions.lock); \
    IFS='|' read -r version digest wheel_url <<< "${line#*=}"; \
    test "$version" = 4.0.1; \
    [[ "$digest" =~ ^[0-9a-f]{64}$ ]]; \
    [[ "$wheel_url" == https://files.pythonhosted.org/*/oauthlib-4.0.1-py3-none-any.whl ]]; \
    license_line=$(grep '^ce_global_python_oauthlib_license=' /tmp/uvm-g7-versions.lock); \
    IFS='|' read -r license_digest license_name <<< "${license_line#*=}"; \
    test "$license_name" = OAUTHLIB-4.0.1-BSD-3-Clause.txt; \
    printf '%s  %s\n' "$license_digest" /tmp/ce-global-oauthlib-license.txt | sha256sum -c -; \
    printf 'oauthlib @ %s --hash=sha256:%s\n' "$wheel_url" "$digest" > /tmp/ce-global-python-requirements.txt; \
    python3 -m pip install --no-cache-dir --no-deps --require-hashes -r /tmp/ce-global-python-requirements.txt; \
    python3 -c 'import importlib.metadata as m, oauthlib, requests_oauthlib; assert m.version("oauthlib") == oauthlib.__version__ == "4.0.1"; print("CE-global oauthlib", oauthlib.__version__, "requests-oauthlib", m.version("requests-oauthlib"))'; \
    python3 -m pip check; \
    rm -f /tmp/ce-global-python-requirements.txt /tmp/ce-global-oauthlib-license.txt
COPY --from=valkey-bin /usr/local/bin/valkey-server /opt/valkey/bin/valkey-server
COPY --from=valkey-bin /usr/local/bin/valkey-cli /opt/valkey/bin/valkey-cli
COPY --from=valkey-bin /tmp/volt-valkey-ld-musl.so.1 /opt/valkey/lib/ld-musl.so.1
COPY --from=valkey-bin /tmp/volt-valkey-libc.musl.so.1 /opt/valkey/lib/libc.musl.so.1
COPY --from=valkey-bin /usr/lib/libssl.so.3 /opt/valkey/lib/libssl.so.3
COPY --from=valkey-bin /usr/lib/libcrypto.so.3 /opt/valkey/lib/libcrypto.so.3
WORKDIR /opt/uvm/app
COPY --from=uvm-build --chown=uvm:uvm /opt/uvm/venv /opt/uvm/venv
COPY --from=uvm-build --chown=uvm:uvm /build/uvm ./uvm
# Installer helpers run as the host UID as well as the API UID. Archive-based
# build contexts may carry0700 directory modes; public application code must
# remain traversable without changing ownership or private runtime custody.
RUN find /opt/uvm/app/uvm -type d -exec chmod 0755 '{}' +
COPY --chown=1001:1337 docker/g7/beat_progress_scheduler.py /app/beat_progress_scheduler.py
COPY --chown=1001:1337 docker/g7/verification_middleware.py /app/g7_verification_middleware.py
COPY --chown=uvm:uvm tools/g7_container_audit_export.py /opt/uvm/app/tools/g7_container_audit_export.py
COPY --chown=uvm:uvm tools/g7_recovery_retained_fixture.py /opt/uvm/app/tools/g7_recovery_retained_fixture.py
COPY --chown=uvm:uvm tools/g7_context_retained_fixture.py /opt/uvm/app/tools/g7_context_retained_fixture.py
COPY --chown=uvm:uvm tools/g7_exception_warning_provider.py /opt/uvm/app/tools/g7_exception_warning_provider.py
COPY --chown=uvm:uvm tools/g7_exception_warning_smtp.py /opt/uvm/app/tools/g7_exception_warning_smtp.py
COPY --chown=uvm:uvm tools/g7_exception_warning_oidc_proxy.py /opt/uvm/app/tools/g7_exception_warning_oidc_proxy.py
COPY --chown=uvm:uvm tools/g7_exception_warning_evidence.py /opt/uvm/app/tools/g7_exception_warning_evidence.py
COPY --chown=uvm:uvm tools/g7_network_assert.py /opt/uvm/app/tools/g7_network_assert.py
COPY --from=uvm-build --chown=uvm:uvm /build/migrations ./migrations
COPY --from=uvm-build --chown=uvm:uvm /build/alembic.ini ./alembic.ini
COPY --from=uvm-build --chown=uvm:uvm /build/pyproject.toml ./pyproject.toml
COPY --from=uvm-build --chown=uvm:uvm /build/uv.lock ./uv.lock
COPY --from=ui-build --chown=uvm:uvm /ui/dist /opt/uvm/ui
COPY --chown=uvm:uvm THIRD-PARTY-NOTICES.md LICENSE /usr/share/doc/volt/third-party/
COPY --chown=uvm:uvm third-party/notices/ /usr/share/doc/volt/third-party/source/
WORKDIR /app
COPY docker/g7/local_maintenance.py /usr/local/bin/uvm-local-maintenance
COPY docker/g7/entrypoint.sh /usr/local/bin/uvm-g7-entrypoint
COPY docker/g7/identity_runtime.sh /usr/local/bin/uvm-g7-identity-runtime
COPY docker/g7/schema-head /etc/uvm-g7-schema-head
COPY docker/g7/healthcheck.sh /usr/local/bin/uvm-g7-healthcheck
COPY docker/g7/valkey-server /usr/local/bin/valkey-server
COPY docker/g7/valkey-cli /usr/local/bin/valkey-cli
RUN chmod 0755 /usr/local/bin/uvm-local-maintenance /usr/local/bin/uvm-g7-entrypoint /usr/local/bin/uvm-g7-identity-runtime /usr/local/bin/uvm-g7-healthcheck /usr/local/bin/valkey-server /usr/local/bin/valkey-cli
# ONE canonical protected routing implementation, shared physically by ROOT
# isolated control and the UID1800 API bridge. API-owned package imports are
# forbidden in the broker/control closure.
COPY --chown=0:0 uvm/auth/route_check_records.py /usr/local/lib/volt-private/volt_route_check_records.py
COPY --chown=0:0 uvm/installer/route_check.py /usr/local/lib/volt-private/volt_route_check_control.py
COPY --chown=0:0 docker/g7/main_api_launcher.py /usr/local/libexec/volt-main-api-launcher.py
COPY --chown=0:0 docker/g7/route_check_control.py /usr/local/libexec/volt-route-check-control.py
COPY --chown=0:0 uvm/installer/terminal_write.py /usr/local/libexec/volt-terminal-write.py
COPY --chown=0:0 uvm/installer/terminal_completion.py /usr/local/libexec/volt-main-api-completion.py
COPY --chown=0:0 uvm/installer/start_admission.py /usr/local/libexec/volt-start-admission.py
COPY --chown=0:0 docker/g7/check_protected_python.py /usr/local/libexec/volt-check-protected-python.py
RUN chown root:root /opt/uvm /opt/uvm/venv /opt/uvm/venv/bin /opt/uvm/venv/bin/python-uvm /opt/uvm/venv/pyvenv.cfg \
    && chmod 0755 /opt/uvm /opt/uvm/venv /opt/uvm/venv/bin /opt/uvm/venv/bin/python-uvm \
    && chmod 0644 /opt/uvm/venv/pyvenv.cfg \
    && install -d -o root -g root -m 0755 /usr/local/lib/volt-private /usr/local/libexec \
    && chmod 0644 /usr/local/lib/volt-private/volt_route_check_records.py /usr/local/lib/volt-private/volt_route_check_control.py \
    && chmod 0755 /usr/local/libexec/volt-start-admission.py /usr/local/libexec/volt-main-api-launcher.py /usr/local/libexec/volt-route-check-control.py /usr/local/libexec/volt-terminal-write.py /usr/local/libexec/volt-main-api-completion.py /usr/local/libexec/volt-check-protected-python.py \
    && env -i PATH=/usr/bin:/bin LC_ALL=C /usr/local/bin/python3.14 -I -S /usr/local/libexec/volt-check-protected-python.py
RUN valkey-server --version && valkey-cli --version
# pip is retained in the build stage for uv installation only. The final CE
# runtime installs no packages dynamically; remove its installer and vendored
# wheels so they do not ship as an unused, independently vulnerable toolchain.
RUN python3 - <<'PY'
from pathlib import Path
import shutil

site = Path('/usr/local/lib/python3.14/site-packages')
pip = site / 'pip'
shutil.rmtree(pip, ignore_errors=True)
for path in site.glob('pip-*.dist-info'):
    shutil.rmtree(path, ignore_errors=True)
for path in (Path('/usr/local/bin/pip'), Path('/usr/local/bin/pip3'), Path('/usr/local/bin/pip3.14')):
    path.unlink(missing_ok=True)
if pip.exists() or list(site.glob('pip-*.dist-info')):
    raise SystemExit('pip remains in final runtime')
PY
ARG VOLT_OIDC_DEPLOYMENT_MODES=demo,external,local
ARG VOLT_SOURCE_SNAPSHOT=unspecified
LABEL org.volt.oidc-deployment-modes=${VOLT_OIDC_DEPLOYMENT_MODES} \
      org.volt.compose.source-snapshot=${VOLT_SOURCE_SNAPSHOT} \
      org.volt.compose-install.contract=1
ENV PATH=/opt/uvm/venv/bin:$PATH \
    PYTHONPATH=/opt/uvm/app \
    PGDATA=/var/lib/postgresql/data \
    DD_MEDIA_ROOT=/app/media \
    DD_DATABASE_HOST=127.0.0.1 \
    DD_DATABASE_PORT=5432 \
    DD_CELERY_BROKER_URL=redis://127.0.0.1:6379/0 \
    DD_CACHE_URL=redis://127.0.0.1:6379/1 \
    DD_ALLOWED_HOSTS='*' \
    DD_INITIALIZE=true \
    DD_DEDUPLICATION_ALGORITHM_PER_PARSER='{"Generic Findings Import":"unique_id_from_tool"}' \
    DD_UWSGI_MODE=socket \
    DD_UWSGI_ENDPOINT=127.0.0.1:3031 \
    UVM_API_HOST=0.0.0.0 \
    UVM_API_PORT=8000 \
    UVM_G7_RECOVERY_CONTROL_PORT=8002
VOLUME ["/var/lib/postgresql/data", "/app/media", "/opt/uvm/state"]
EXPOSE 8000 8002
HEALTHCHECK --interval=10s --timeout=4s --start-period=180s --retries=3 CMD ["/usr/local/bin/uvm-g7-healthcheck"]
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/uvm-g7-entrypoint"]
