# Set by setup for each private instance. Never commit the generated .env.
VOLT_PROJECT=volt-compose
VOLT_INSTANCE_DIR=./state
VOLT_OWNER_TOKEN=generated-by-setup
VOLT_SUBNET=10.254.0.0/28
VOLT_GATEWAY=10.254.0.1
VOLT_IMAGE=sha256:REPLACE_WITH_EXPLICIT_COMPOSE_COMPATIBLE_CANDIDATE
VOLT_IMAGE_ID=sha256:REPLACE_WITH_ADMITTED_CANDIDATE_IMAGE_ID
VOLT_BOOTSTRAP_PRINCIPAL=REPLACE_WITH_EXACT_ADMIN_PRINCIPAL_ID
VOLT_NATIVE_GRANTABLE_ENVELOPE={"actions":["access_group.read","ownership.team.read","ownership.team.manage"],"target_scope":{"group_ids":["*"],"source_families":["*"],"environments":["*"],"service_ids":["*"],"membership_mode":"all_current"},"source_scopes":[],"limits":{"maximum_acceptance_days":null,"maximum_severity":null,"whole_group_confirmation":false,"allowed_environments":["*"],"allowed_service_ids":["*"],"allowed_sla_clock_bases":[],"allowed_sla_severities":[],"allowed_sla_start_sources":[],"maximum_sla_duration_seconds":null,"allow_sla_backfill":false,"maximum_deadline_extension_seconds":null,"allowed_identity_scalar_fields":{}},"separation_of_duties":{"approval_requires_distinct_actor":true,"prohibit_requester_approval":true,"required_approver_count":1,"prohibited_action_pairs":[]}}
VOLT_HTTP_PORT=8180
VOLT_RECOVERY_PORT=8181
VOLT_OIDC_PORT=8190
VOLT_ALLOWED_HOSTS=localhost,127.0.0.1
