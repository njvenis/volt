# Copy values to secret files under /run/secrets; never put credentials here.
UVM_DB_NAME=uvm
CE_DB_NAME=defectdojo
PGDATA=/var/lib/postgresql/data
CE_MEDIA_ROOT=/app/media
UVM_STATE_ROOT=/opt/uvm/state
UVM_API_PORT=8000
DD_PORT=8081
DD_ADMIN_USER=admin
DD_ADMIN_MAIL=admin@defectdojo.local
DD_ADMIN_FIRST_NAME=Synthetic
DD_ADMIN_LAST_NAME=Operator
DD_INITIALIZE=true
DD_ALLOWED_HOSTS=localhost,127.0.0.1
# Enable only after configuring scoped destinations and protected secret files.
UVM_EXCEPTION_WARNING_WORKER=0
UVM_EXCEPTION_WARNING_DESTINATIONS={}
UVM_EXCEPTION_WARNING_POLL_SECONDS=15
UVM_EXCEPTION_WARNING_BATCH_SIZE=20
