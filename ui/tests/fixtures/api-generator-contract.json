            "type": "string"
          },
          "optionalName": {
            "type": "string"
          },
          "nullableRequired": {
            "type": [
              "string",
              "null"
            ]
          },
          "optionalNullable": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "selection": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ]
          },
