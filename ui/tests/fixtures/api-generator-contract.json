          },
          "message": {
            "type": "string"
          }
        }
      },
      "Merged": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "a"
            ],
            "properties": {
              "a": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "required": [
              "b"
            ],
            "properties": {
              "b": {
                "type": "integer"
              }
            }
          }
        ]
